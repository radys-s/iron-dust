; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Iron Dust"
config/description="1872, americký jihozápad. Ekonomicko-strategická tahová hra."
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/game/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; 3 = fullscreen bez ramecku, prekryje i hlavni panel Windows. Zamerne NE
; exclusive (4) — alt-tab je pak pomaly a na dvou monitorech to zlobi.
window/size/mode=3
window/size/borderless=true
window/stretch/mode="canvas_items"
; "expand" misto "keep": pri fullscreenu na jinem pomeru nez 16:9 by "keep"
; letterboxoval. Vynucuje si to kotveny layout misto pevnych 1920x1080 pixelu.
window/stretch/aspect="expand"

[input]

game_end_turn={
"deadzone": 0.5,
